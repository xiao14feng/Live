# 环境配置示例文件
# 复制为 .env 并修改相应值

# 应用配置
APP_NAME="直播辩论后端API"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true

# 微信配置
WECHAT_APPID="wx94289b0d2ca7a802"
WECHAT_SECRET="your-wechat-secret-here"
WECHAT_USE_MOCK=true

# JWT配置
JWT_SECRET="your-jwt-secret-key-change-in-production"
JWT_ALGORITHM="HS256"
JWT_EXPIRE_HOURS=168

# 数据库配置
DATABASE_URL="sqlite:///./live_debate.db"

# API配置
API_PREFIX="/api"
DOCS_URL="/docs"
REDOC_URL="/redoc"

# CORS配置 (开发环境)
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8080", "http://127.0.0.1:3000"]